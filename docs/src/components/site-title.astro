---
import config from 'virtual:starlight/user-config';
import { logos } from 'virtual:starlight/user-images';

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	{config.logo && logos.dark && <img alt={config.logo.alt} src={logos.dark.src} width={logos.dark.width} height={logos.dark.height} />}
	<span translate="no"><strong>Lettermint</strong> for Craft CMS</span>
</a>

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			color: var(--sl-color-text-accent);
			font-size: var(--sl-text-h4);
			font-weight: 500;
			gap: var(--sl-nav-gap);
			min-width: 0;
			text-decoration: none;
			white-space: nowrap;
		}

		strong {
			font-weight: 600;
		}

		span {
			overflow: hidden;
		}

		img {
			height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
			max-width: 100%;
			object-fit: contain;
			object-position: 0 50%;
			width: auto;
		}
	}
</style>
