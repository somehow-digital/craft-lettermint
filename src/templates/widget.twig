{% import 'lettermint/utility/_macros' as ui %}

{% set body %}
	<div class="lettermint-widget-header">
		{% set team = data.setup ? null : data.team %}
		{% if team %}
			<p class="lettermint-widget-team">{{ team.name ?? 'Team'|t('lettermint') }}</p>
			{{ ui.planBadge(team) }}
			{% if data.project %}
				{{ ui.deliveryMode(data.project) }}
			{% endif %}
		{% endif %}
		{{ ui.iconButton('a', 'arrow-right', 'Open utility'|t('lettermint'), {
			href: cpUrl(utilityPath),
			class: ['small', 'lettermint-widget-open'],
		}) }}
	</div>

	{% if data.setup %}
		{{ ui.setupCallout(data.setup) }}
	{% else %}
		{% if data.token.status is not same as(enum('SomehowDigital\\Craft\\Lettermint\\enums\\CheckStatus').Ok) %}
			{{ ui.settingsCallout(data.token.status.value, data.token.text) }}
		{% endif %}

		{% if not data.teamError %}
			<div class="lettermint-tiles">
				{{ ui.usageTile(data.usage, data.usageError) }}
			</div>
		{% endif %}

		{% if data.stats or data.statsError %}
			<section aria-labelledby="lettermint-widget-stats">
				<h3 id="lettermint-widget-stats" class="lettermint-widget-heading">{{ 'Last {days} days'|t('lettermint', {days: statsDays}) }}</h3>
				{% if data.statsError %}
					{{ ui.apiError(data.statsError) }}
				{% else %}
					<div class="lettermint-tiles">
						{{ ui.deliveryTiles(data.stats.totals) }}
					</div>
					{{ ui.chart(data.stats.daily, placeholder) }}
				{% endif %}
			</section>
		{% endif %}

		{% if data.projectError is same as(enum('SomehowDigital\\Craft\\Lettermint\\enums\\ApiError').Missing) %}
			{{ ui.projectMissingCallout(data.projectId) }}
		{% elseif data.projectChecks %}
			{% set ok = enum('SomehowDigital\\Craft\\Lettermint\\enums\\CheckStatus').Ok %}
			{% set problems = data.projectChecks|filter(check => check.status is not same as(ok)) %}
			<section aria-labelledby="lettermint-widget-checks">
				<h3 id="lettermint-widget-checks" class="lettermint-widget-heading">{{ 'Checks'|t('lettermint') }}</h3>
				{% if problems %}
					{{ ui.checks(problems) }}
				{% else %}
					{{ ui.checks([{status: ok, text: 'All checks passed'|t('lettermint')}]) }}
				{% endif %}
			</section>
		{% endif %}
	{% endif %}

	{% if data.loaded %}
		<div class="lettermint-widget-footer">
			{{ ui.loadedNote('Loaded at {time}'|t('lettermint', {time: data.loadedAt|time('short')})) }}
			{{ include('lettermint/utility/_refresh', {action: constant('SomehowDigital\\Craft\\Lettermint\\widgets\\LettermintWidget::ACTION')}) }}
		</div>
	{% endif %}
{% endset %}

{{ ui.part('widget', 'lettermint-utility lettermint-widget', body, loading, placeholder) }}
