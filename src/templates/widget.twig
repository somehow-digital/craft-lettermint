{# The usage, statistics and checks of the utility, in the space of a widget. #}
{% import 'lettermint/utility/_macros' as ui %}

<div class="lettermint-utility lettermint-widget">
	<div class="lettermint-widget-header">
		{% set team = not setup and not sections.team.error ? sections.team.data : null %}
		{% if team %}
			<p class="lettermint-widget-team">{{ team.name ?? 'Team'|t('lettermint') }}</p>
			{{ ui.planBadge(team) }}
			{% if project.data %}
				{{ ui.deliveryMode(project.data) }}
			{% endif %}
		{% endif %}
		{{ ui.iconButton('a', 'arrow-right', 'Open utility'|t('lettermint'), {
			href: cpUrl(utilityPath),
			class: ['small', 'lettermint-widget-open'],
		}) }}
	</div>

	{% if setup %}
		{{ ui.setupCallout(setup) }}
	{% else %}
		{% if checks.token.status is not same as(enum('SomehowDigital\\Craft\\Lettermint\\CheckStatus').Ok) %}
			{{ ui.settingsCallout(checks.token.status.value, checks.token.text) }}
		{% endif %}

		{% if not sections.team.error %}
			<div class="lettermint-tiles">
				{{ ui.usageTile(usage, sections.usage.error) }}
			</div>
		{% endif %}

		{% if sections.stats ?? null %}
			{% set stats = sections.stats.data %}
			<section aria-labelledby="lettermint-widget-stats">
				<h3 id="lettermint-widget-stats" class="lettermint-widget-heading">{{ 'Last {days} days'|t('lettermint', {days: statsDays}) }}</h3>
				{% if sections.stats.error %}
					{{ ui.sectionError(sections.stats.error) }}
				{% else %}
					<div class="lettermint-tiles">
						{{ ui.deliveryTiles(stats.totals) }}
					</div>
					{{ ui.chart(stats.daily) }}
				{% endif %}
			</section>
		{% endif %}

		{% if project.error is same as(enum('SomehowDigital\\Craft\\Lettermint\\SectionError').Missing) %}
			{{ ui.projectMissingCallout(project) }}
		{% elseif checks.project %}
			{% set ok = enum('SomehowDigital\\Craft\\Lettermint\\CheckStatus').Ok %}
			{% set problems = checks.project|filter(check => check.status is not same as(ok)) %}
			<section aria-labelledby="lettermint-widget-checks">
				<h3 id="lettermint-widget-checks" class="lettermint-widget-heading">{{ 'Checks'|t('lettermint') }}</h3>
				{% if problems %}
					{{ ui.checks(problems) }}
				{% else %}
					{{ ui.checks([{status: ok, text: 'All checks passed'|t('lettermint')}]) }}
				{% endif %}
			</section>
		{% endif %}
	{% endif %}

	{% if sections %}
		<div class="lettermint-widget-footer">
			{{ ui.loadedNote('Loaded at {time}'|t('lettermint', {time: loadedAt|time('short')})) }}
			{{ include('lettermint/utility/_refresh', {redirect: 'dashboard'}) }}
		</div>
	{% endif %}
</div>
