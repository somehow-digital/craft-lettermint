{% import '_includes/forms' as forms %}

{{ forms.autosuggestField({
	label: 'Project API Token'|t('lettermint'),
	instructions: 'Lettermint project API token.'|t('lettermint'),
	id: 'token',
	name: 'token',
	value: adapter.token,
	suggestEnvVars: true,
	errors: adapter.getErrors('token'),
}) }}

{{ forms.autosuggestField({
	label: 'Route Slug'|t('lettermint'),
	instructions: 'Lettermint project route slug.'|t('lettermint'),
	id: 'route',
	name: 'route',
	value: adapter.route,
	suggestEnvVars: true,
	errors: adapter.getErrors('route'),
}) }}

{{ forms.autosuggestField({
	label: 'Tags'|t('lettermint'),
	instructions: 'Lettermint tags as comma-separated name=value pairs, e.g. `environment=production, campaign=welcome`.'|t('lettermint'),
	id: 'tags',
	name: 'tags',
	value: adapter.tags,
	suggestEnvVars: true,
	errors: adapter.getErrors('tags'),
}) }}

{% if pro %}
	{% css %}
		.lettermint-pro-badge {
			background-color: var(--gray-100);
			border: 1px solid var(--border-hairline);
			border-radius: var(--radius-sm);
			color: var(--gray-700);
			font-size: .6875rem;
			line-height: 1.45;
			padding-inline: .25em;
		}
	{% endcss %}

	{% set proBadge = tag('span', {
		text: 'Pro'|t('lettermint'),
		class: 'lettermint-pro-badge',
	}) %}

	{{ forms.autosuggestField({
		label: 'Team API Token'|t('lettermint'),
		headingSuffix: proBadge,
		instructions: 'Lettermint team API token.'|t('lettermint'),
		id: 'teamToken',
		name: 'teamToken',
		value: adapter.teamToken,
		suggestEnvVars: true,
		errors: adapter.getErrors('teamToken'),
	}) }}

	{{ forms.autosuggestField({
		label: 'Project'|t('lettermint'),
		headingSuffix: proBadge,
		instructions: 'ID of the Lettermint project of the project API token, which the Lettermint utility shows. Leave it blank when the team has a single project.'|t('lettermint'),
		id: 'project',
		name: 'project',
		value: adapter.project,
		suggestions: projectSuggestions,
		suggestEnvVars: true,
		errors: adapter.getErrors('project'),
	}) }}

	{{ forms.autosuggestField({
		label: 'Webhook Secret'|t('lettermint'),
		headingSuffix: proBadge,
		instructions: 'Signing secret of a Lettermint webhook with the endpoint URL `{url}`, which fires its events in Craft. Leave it blank to turn the endpoint off.'|t('lettermint', {
			url: webhookUrl,
		}),
		id: 'webhookSecret',
		name: 'webhookSecret',
		value: adapter.webhookSecret,
		suggestEnvVars: true,
		errors: adapter.getErrors('webhookSecret'),
	}) }}

	{{ forms.editableTableField({
		label: 'Sites'|t('lettermint'),
		headingSuffix: proBadge,
		instructions: 'Route slug and tags for emails of each site. Leave the route slug blank to use the one above. Tags are added to the ones above, replacing those with the same name.'|t('lettermint'),
		tip: 'This can begin with an environment variable.'|t('app') ~ ' ' ~ tag('a', {
			text: 'Learn more'|t('app'),
			href: 'https://craftcms.com/docs/5.x/configure.html#control-panel-settings',
			class: 'go',
		}),
		id: 'sites',
		name: 'sites',
		cols: {
			heading: {
				type: 'heading',
				heading: 'Site'|t('lettermint'),
			},
			route: {
				type: 'autosuggest',
				heading: 'Route Slug'|t('lettermint'),
				suggestEnvVars: true,
			},
			tags: {
				type: 'autosuggest',
				heading: 'Tags'|t('lettermint'),
				suggestEnvVars: true,
			},
		},
		rows: siteRows,
		staticRows: true,
		allowAdd: false,
		allowDelete: false,
		allowReorder: false,
		errors: adapter.getErrors('sites'),
	}) }}
{% else %}
	{# Keeps the team token, the project, the webhook secret and the routes and tags of the sites when the settings are saved in the standard edition. #}
	{% if adapter.teamToken %}
		{{ hiddenInput('teamToken', adapter.teamToken) }}
	{% endif %}

	{% if adapter.project %}
		{{ hiddenInput('project', adapter.project) }}
	{% endif %}

	{% if adapter.webhookSecret %}
		{{ hiddenInput('webhookSecret', adapter.webhookSecret) }}
	{% endif %}

	{% for uid, options in adapter.sites %}
		{% for key, value in options %}
			{{ hiddenInput("sites[#{uid}][#{key}]", value) }}
		{% endfor %}
	{% endfor %}
{% endif %}
