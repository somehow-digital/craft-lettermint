{% import "_includes/forms" as forms %}

{% set tokenConfig = {
	label: "API Token"|t('lettermint'),
	instructions: "Lettermint project API token."|t('lettermint'),
	id: 'token',
	name: 'token',
	value: adapter.token,
	suggestEnvVars: true,
	errors: adapter.getErrors('token')
} %}

{% if tokenStatus %}
	{# The status is added below the input, which the autosuggest field macro does not allow, so its tip is added here. #}
	{% if (adapter.token ?? '')[0:1] not in ['$', '@'] %}
		{% set tokenConfig = tokenConfig|merge({
			tip: "This can begin with an environment variable."|t('app') ~ ' ' ~ tag('a', {
				href: 'https://craftcms.com/docs/5.x/configure.html#control-panel-settings',
				class: 'go',
				text: "Learn more"|t('app'),
			}),
		}) %}
	{% endif %}

	{% set tokenConfig = tokenConfig|merge({
		describedBy: [
			'token-instructions',
			'token-status',
			tokenConfig.tip is defined ? 'token-tip',
			tokenConfig.errors ? 'token-errors',
		]|filter|join(' '),
	}) %}

	{% css %}
		.lettermint-token-status {
			align-items: center;
			display: flex;
			gap: .375em;
			margin-block-start: .5em;
		}

		.lettermint-token-status .cp-icon {
			--icon-color: currentColor;
		}
	{% endcss %}

	{% set status = {
		valid: { class: 'success', icon: 'circle-check', text: "API token is valid."|t('lettermint') },
		invalid: { class: 'error', icon: 'circle-xmark', text: "API token is invalid."|t('lettermint') },
		unknown: { class: 'light', icon: 'circle-question', text: "API token could not be checked."|t('lettermint') },
	}[tokenStatus] %}

	{{ forms.field(tokenConfig, include('_includes/forms/autosuggest', tokenConfig) ~ tag('p', {
		id: 'token-status',
		class: ['lettermint-token-status', status.class],
		html: tag('span', { class: ['cp-icon', 'small'], 'aria-hidden': 'true', html: iconSvg(status.icon) }) ~ tag('span', { text: status.text }),
	})) }}
{% else %}
	{{ forms.autosuggestField(tokenConfig) }}
{% endif %}

{{ forms.autosuggestField({
	label: "Route Slug"|t('lettermint'),
	instructions: "Lettermint project route slug."|t('lettermint'),
	id: 'route',
	name: 'route',
	value: adapter.route,
	suggestEnvVars: true,
	errors: adapter.getErrors('route')
}) }}

{{ forms.autosuggestField({
	label: "Tags"|t('lettermint'),
	instructions: "Lettermint tags as comma-separated name=value pairs, e.g. `environment=production, campaign=welcome`."|t('lettermint'),
	id: 'tags',
	name: 'tags',
	value: adapter.tags,
	suggestEnvVars: true,
	errors: adapter.getErrors('tags')
}) }}

{% if pro %}
	{% css %}
		.lettermint-pro-badge {
			background-color: var(--gray-100);
			border: 1px solid var(--border-hairline);
			border-radius: var(--radius-sm);
			color: var(--gray-700);
			font-size: .6875rem;
			line-height: 1.45;
			padding-inline: .25em;
		}
	{% endcss %}

	{{ forms.editableTableField({
		label: "Sites"|t('lettermint'),
		headingSuffix: tag('span', {
			text: "Pro"|t('lettermint'),
			class: 'lettermint-pro-badge',
		}),
		instructions: "Route slug and tags for emails of each site. Leave the route slug blank to use the one above. Tags are added to the ones above, replacing those with the same name."|t('lettermint'),
		tip: "This can begin with an environment variable."|t('app') ~ ' ' ~ tag('a', {
			text: "Learn more"|t('app'),
			href: 'https://craftcms.com/docs/5.x/configure.html#control-panel-settings',
			class: 'go',
		}),
		id: 'sites',
		name: 'sites',
		cols: {
			heading: {
				type: 'heading',
				heading: "Site"|t('lettermint'),
			},
			route: {
				type: 'autosuggest',
				heading: "Route Slug"|t('lettermint'),
				suggestEnvVars: true,
			},
			tags: {
				type: 'autosuggest',
				heading: "Tags"|t('lettermint'),
				suggestEnvVars: true,
			},
		},
		rows: siteRows,
		staticRows: true,
		allowAdd: false,
		allowDelete: false,
		allowReorder: false,
		errors: adapter.getErrors('sites'),
	}) }}
{% else %}
	{# Keeps the routes and tags of the sites when the settings are saved in the standard edition. #}
	{% for uid, options in adapter.sites %}
		{% for key, value in options %}
			{{ hiddenInput("sites[#{uid}][#{key}]", value) }}
		{% endfor %}
	{% endfor %}
{% endif %}
