{# The checks of the project and the team token, as the health endpoint reports them, with what the token is for when it passes. #}
{% import 'lettermint/utility/_macros' as ui %}

{% set statuses = {
	ok: {tone: 'green', label: 'Valid'|t('lettermint')},
	warning: {tone: 'yellow', label: 'Warning'|t('lettermint')},
	error: {tone: 'red', label: 'Error'|t('lettermint')},
} %}
{% set items = {
	token: {
		label: 'Project API Token'|t('lettermint'),
		description: 'The project API token, which sends the emails.'|t('lettermint'),
		check: data.token,
	},
	teamToken: {
		label: 'Team API Token'|t('lettermint'),
		description: 'The team API token, which this page is loaded with.'|t('lettermint'),
		check: data.teamToken,
	},
} %}
<section aria-labelledby="lettermint-tokens">
	{{ ui.sectionHeader('lettermint-tokens', 'API Tokens'|t('lettermint')) }}
	<ul class="lettermint-card lettermint-tokens">
		{% for item in items %}
			{% set check = item.check %}
			<li>
				<div>
					<p class="lettermint-token-name">{{ item.label }}</p>
					<p class="lettermint-token-description">
						{%- if check and check.status is not same as(enum('SomehowDigital\\Craft\\Lettermint\\enums\\CheckStatus').Ok) -%}
							{{ check.text }}
						{%- else -%}
							{{ item.description }}
						{%- endif -%}
					</p>
				</div>
				{% if check %}
					{{ ui.pill(statuses[check.status.value].tone, statuses[check.status.value].label) }}
				{% else %}
					{{ ui.pill('gray', 'Not set'|t('lettermint')) }}
				{% endif %}
			</li>
		{% endfor %}
	</ul>
</section>
