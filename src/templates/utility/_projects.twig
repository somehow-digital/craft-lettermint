{# The projects of the team. #}
{% import 'lettermint/utility/_macros' as ui %}

{% set count = sections.team.data.projects_count ?? null %}
<section aria-labelledby="lettermint-projects">
	{{ ui.sectionHeader('lettermint-projects', 'Projects'|t('lettermint'), count ? '{count, plural, =1{# project} other{# projects}}'|t('lettermint', {count: count})) }}

	{% if sections.projects.error %}
		{{ ui.sectionError(sections.projects.error) }}
	{% elseif sections.projects.data.data ?? [] %}
		<div class="lettermint-card">
			<div class="lettermint-table">
				<table class="data fullwidth">
					<thead>
						<tr>
							<th scope="col">{{ 'Name'|t('lettermint') }}</th>
							<th scope="col">{{ 'Mode'|t('lettermint') }}</th>
							<th scope="col" class="lettermint-number">{{ 'Routes'|t('lettermint') }}</th>
							<th scope="col" class="lettermint-number">{{ 'Domains'|t('lettermint') }}</th>
							<th scope="col" class="lettermint-number">{{ 'Emails (28 days)'|t('lettermint') }}</th>
							<th scope="col" class="lettermint-number">{{ 'Deliverability'|t('lettermint') }}</th>
						</tr>
					</thead>
					<tbody>
						{% for item in sections.projects.data.data %}
							{% set stats = item.last_28_days ?? {} %}
							{% set emails = (stats.messages_transactional ?? 0) + (stats.messages_broadcast ?? 0) %}
							<tr>
								<th scope="row">
									{{ item.name }}
									{% if project.data and project.data.id == item.id %}
										{{ ui.currentBadge() }}
									{% endif %}
								</th>
								<td>{{ ui.deliveryMode(item) }}</td>
								<td class="lettermint-number">{{ (item.routes_count ?? 0)|number }}</td>
								<td class="lettermint-number">{{ (item.domains_count ?? 0)|number }}</td>
								<td class="lettermint-number">{{ emails|number }}</td>
								<td class="lettermint-number">{{ ui.deliverability(stats.deliverability ?? null, emails) }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>

			{{ ui.truncated(sections.projects.data, pageSize) }}
		</div>
	{% else %}
		<p class="light">{{ 'There are no projects yet.'|t('lettermint') }}</p>
	{% endif %}
</section>
