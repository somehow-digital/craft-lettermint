{% import 'lettermint/utility/_macros' as ui %}

{% set body %}
	{% if data.setup %}
		{{ ui.setupCallout(data.setup) }}
		{% if data.setup is not same as(enum('SomehowDigital\\Craft\\Lettermint\\enums\\Setup').Transport) %}
			{{ include('lettermint/utility/_tokens') }}
		{% endif %}
	{% else %}
		{{ include('lettermint/utility/_team') }}
		{{ include('lettermint/utility/_tokens') }}
		{{ include('lettermint/utility/_project') }}
		{% if data.project %}
			{{ include('lettermint/utility/_stats') }}
			{{ include('lettermint/utility/_domains') }}
		{% endif %}
	{% endif %}
{% endset %}

{{ ui.part('content', 'lettermint-utility', body, loading, placeholder) }}
