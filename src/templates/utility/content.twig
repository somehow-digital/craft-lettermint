{% import 'lettermint/utility/_macros' as ui %}

<div class="lettermint-utility">
	{% if setup %}
		{{ ui.setupCallout(setup) }}
		{% if setup != 'transport' %}
			{{ include('lettermint/utility/_tokens') }}
		{% endif %}
	{% else %}
		{{ include('lettermint/utility/_team') }}
		{{ include('lettermint/utility/_tokens') }}
		{{ include('lettermint/utility/_project') }}
		{{ include('lettermint/utility/_stats') }}
		{{ include('lettermint/utility/_projects') }}
		{{ include('lettermint/utility/_domains') }}
	{% endif %}
</div>
