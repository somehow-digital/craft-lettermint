{# The share of a part in a whole, or a dash when there is nothing to compare with. #}
{% macro rate(part, whole) %}
	{%- if part is not null and whole -%}
		{{ (part / whole)|percentage(1) }}
	{%- else -%}
		–
	{%- endif -%}
{% endmacro %}

{#
 # The tone of a rate: `good`, `fair` or `poor`, or null when there is nothing to rate.
 # Rates at or above `good` are good for rates where higher is better, and the other way round otherwise.
 #}
{% macro tone(rate, good, fair, higherIsBetter = true) %}
	{%- if rate is not null -%}
		{%- if higherIsBetter -%}
			{{ rate >= good ? 'good' : (rate >= fair ? 'fair' : 'poor') }}
		{%- else -%}
			{{ rate < good ? 'good' : (rate < fair ? 'fair' : 'poor') }}
		{%- endif -%}
	{%- endif -%}
{% endmacro %}

{# The icon of a status. #}
{% macro statusIcon(status) %}
	{%- set icons = {
		ok: 'circle-check',
		info: 'circle-info',
		warning: 'triangle-exclamation',
		error: 'circle-xmark',
	} -%}
	{{- iconSvg(icons[status]) -}}
{% endmacro %}

{# A message with an icon of its status, and an optional link below it. #}
{% macro callout(status, text, link = null) %}
	<div class="lettermint-callout lettermint-{{ status }}">
		<span class="cp-icon" aria-hidden="true">{{ _self.statusIcon(status) }}</span>
		<div>
			<p>{{ text }}</p>
			{% if link %}
				<p>{{ link|raw }}</p>
			{% endif %}
		</div>
	</div>
{% endmacro %}

{# The error of a section that could not be loaded. #}
{% macro sectionError(error) %}
	{% if error == 'forbidden' %}
		{{ _self.callout('warning', 'The team API token is not allowed to read this.'|t('lettermint')) }}
	{% else %}
		{{ _self.callout('error', 'This could not be loaded from Lettermint.'|t('lettermint')) }}
	{% endif %}
{% endmacro %}

{# The header of a section, with its heading and an optional note. #}
{% macro sectionHeader(id, heading, meta = null) %}
	<div class="lettermint-section-header">
		<h2 id="{{ id }}">{{ heading }}</h2>
		{% if meta %}
			<span class="lettermint-section-meta">{{ meta }}</span>
		{% endif %}
	</div>
{% endmacro %}

{# A tile with a label, a value and an optional note, coloured by its tone. #}
{% macro tile(label, value, note = null, tone = null) %}
	<div class="lettermint-tile">
		<dt>{{ label }}</dt>
		<dd class="lettermint-tile-value">{{ value }}</dd>
		{% if note is not null %}
			<dd class="lettermint-tile-note{{ tone|trim ? " lettermint-tone-#{tone|trim}" }}">{{ note }}</dd>
		{% endif %}
	</div>
{% endmacro %}

{#
 # A deliverability as a percentage, coloured by its tone, taken as a fraction up to 1 and as a percentage above.
 # There is no deliverability without emails, for which Lettermint reports 0, so it is left out then.
 #}
{% macro deliverability(value, emails) %}
	{%- if value is null or not emails -%}
		–
	{%- else -%}
		{%- set fraction = value > 1 ? value / 100 : value -%}
		<span class="lettermint-tone-{{ _self.tone(fraction, 0.95, 0.9)|trim }}">{{ fraction|percentage(1) }}</span>
	{%- endif -%}
{% endmacro %}

{# A pill with a dot, coloured by its tone. #}
{% macro pill(tone, text) %}
	<span class="lettermint-pill lettermint-pill-{{ tone }}">{{ text }}</span>
{% endmacro %}

{# The delivery mode of a project as a pill. #}
{% macro deliveryMode(project) %}
	{% if (project.delivery_mode ?? null) == 'sandbox' %}
		{{ _self.pill('orange', 'Sandbox'|t('lettermint')) }}
	{% else %}
		{{ _self.pill('green', 'Live'|t('lettermint')) }}
	{% endif %}
{% endmacro %}

{# A badge marking the project of the token, and its domains. #}
{% macro currentBadge() %}
	<span class="lettermint-badge lettermint-subtle">{{ 'Current'|t('lettermint') }}</span>
{% endmacro %}

{# A note below a list that has more items than are listed. #}
{% macro truncated(list, pageSize) %}
	{% if list.next_cursor ?? null %}
		<p class="lettermint-table-note">{{ 'Only the first {count} are listed.'|t('lettermint', {count: pageSize}) }}</p>
	{% endif %}
{% endmacro %}
