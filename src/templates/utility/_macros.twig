{# A part's share of the whole, or a dash without a whole. #}
{% macro rate(part, whole) %}
	{%- if part is not null and whole -%}
		{{ (part / whole)|percentage(1) }}
	{%- else -%}
		–
	{%- endif -%}
{% endmacro %}

{# `good`, `fair`, `poor`, or null without a rate. The thresholds invert when lower is better. #}
{% macro tone(rate, good, fair, higherIsBetter = true) %}
	{%- if rate is not null -%}
		{%- if higherIsBetter -%}
			{{ rate >= good ? 'good' : (rate >= fair ? 'fair' : 'poor') }}
		{%- else -%}
			{{ rate < good ? 'good' : (rate < fair ? 'fair' : 'poor') }}
		{%- endif -%}
	{%- endif -%}
{% endmacro %}

{% macro statusIcon(status) %}
	{%- set icons = {
		ok: 'circle-check',
		info: 'circle-info',
		warning: 'triangle-exclamation',
		error: 'circle-xmark',
	} -%}
	{{- iconSvg(icons[status]) -}}
{% endmacro %}

{# A message with a status icon and an optional link. #}
{% macro callout(status, text, link = null) %}
	<div class="lettermint-callout lettermint-{{ status }}">
		<span class="cp-icon" aria-hidden="true">{{ _self.statusIcon(status) }}</span>
		<div>
			<p>{{ text }}</p>
			{% if link %}
				<p>{{ link|raw }}</p>
			{% endif %}
		</div>
	</div>
{% endmacro %}

{# Why a team API result failed to load. #}
{% macro apiError(error) %}
	{% if error is same as(enum('SomehowDigital\\Craft\\Lettermint\\enums\\ApiError').Forbidden) %}
		{{ _self.callout('warning', 'The team API token is not allowed to read this.'|t('lettermint')) }}
	{% else %}
		{{ _self.callout('error', 'This could not be loaded from Lettermint.'|t('lettermint')) }}
	{% endif %}
{% endmacro %}

{% macro sectionHeader(id, heading, meta = null) %}
	<div class="lettermint-section-header">
		<h2 id="{{ id }}">{{ heading }}</h2>
		{% if meta %}
			<span class="lettermint-section-meta">{{ meta }}</span>
		{% endif %}
	</div>
{% endmacro %}

{% macro tile(label, value, note = null, tone = null) %}
	<dl class="lettermint-tile">
		<dt>{{ label }}</dt>
		<dd class="lettermint-tile-value">{{ value }}</dd>
		{% if note is not null %}
			<dd class="lettermint-tile-note{{ tone|trim ? " lettermint-tone-#{tone|trim}" }}">{{ note }}</dd>
		{% endif %}
	</dl>
{% endmacro %}

{% macro pill(tone, text) %}
	<span class="lettermint-pill lettermint-pill-{{ tone }}">{{ text }}</span>
{% endmacro %}

{# Omitted without a plan. #}
{% macro planBadge(team) %}
	{% if team.plan %}
		<span class="lettermint-badge lettermint-brand">{{ '{plan} plan'|t('lettermint', {plan: team.plan|capitalize}) }}</span>
	{% endif %}
{% endmacro %}

{% macro deliveryMode(project) %}
	{% if project.deliveryMode is same as(constant('SomehowDigital\\Craft\\Lettermint\\models\\Project::DELIVERY_MODE_SANDBOX')) %}
		{{ _self.pill('orange', 'Sandbox'|t('lettermint')) }}
	{% else %}
		{{ _self.pill('green', 'Live'|t('lettermint')) }}
	{% endif %}
{% endmacro %}

{# The meter warns at the same share as the health checks. #}
{% macro usageTile(usage, error) %}
	{% set warning = constant('SomehowDigital\\Craft\\Lettermint\\models\\Checks::USAGE_WARNING') %}
	{% if error %}
		<dl class="lettermint-tile lettermint-tile-wide">
			<dt>{{ 'Usage'|t('lettermint') }}</dt>
			<dd class="lettermint-tile-note">{{ 'This could not be loaded from Lettermint.'|t('lettermint') }}</dd>
		</dl>
	{% elseif usage %}
		<dl class="lettermint-tile lettermint-tile-wide">
			<dt>{{ 'Usage this period'|t('lettermint') }}</dt>
			<dd class="lettermint-tile-value">
				{{ usage.used|number }}
				{% if usage.included %}
					<small>/ {{ '{count} per month'|t('lettermint', {count: usage.included|number}) }}</small>
				{% endif %}
			</dd>
			{% if usage.share is not null %}
				<dd>
					<meter class="lettermint-meter {{ usage.share >= 1 ? 'error' : (usage.share >= warning ? 'warning') }}" min="0" max="{{ usage.included }}" value="{{ usage.used }}" aria-label="{{ 'Usage'|t('lettermint') }}">
						{{- usage.share|percentage(1) -}}
					</meter>
				</dd>
			{% endif %}
			<dd class="lettermint-tile-note">
				{% if usage.share is not null %}
					{{ '{share} of the monthly plan'|t('lettermint', {share: usage.share|percentage(1)}) }}
				{% endif %}
				{% if usage.start and usage.end %}
					{{ usage.share is not null ? '·' }} {{ '{start} – {end}'|t('lettermint', {
						start: usage.start|date('short'),
						end: usage.end|date('short'),
					}) }}
				{% endif %}
			</dd>
		</dl>
	{% endif %}
{% endmacro %}

{% macro deliveryTiles(totals) %}
	{% set sent = totals.sent %}
	{% set delivered = totals.delivered %}
	{% set hardBounced = totals.hardBounced %}
	{% set spamComplaints = totals.spamComplaints %}
	{{ _self.tile('Sent'|t('lettermint'), sent|number) }}
	{{ _self.tile('Delivered'|t('lettermint'), delivered|number, _self.rate(delivered, sent), _self.tone(sent ? delivered / sent : null, 0.95, 0.9)) }}
	{{ _self.tile('Hard bounced'|t('lettermint'), hardBounced|number, _self.rate(hardBounced, sent), _self.tone(sent ? hardBounced / sent : null, 0.02, 0.05, false)) }}
	{{ _self.tile('Spam complaints'|t('lettermint'), spamComplaints|number, _self.rate(spamComplaints, sent), _self.tone(sent ? spamComplaints / sent : null, 0.001, 0.003, false)) }}
{% endmacro %}

{# Emails sent per day; omitted when none were sent. #}
{% macro chart(daily) %}
	{% set peak = daily ? max(daily|column('sent')|merge([0])) : 0 %}
	{% if peak > 0 %}
		<figure class="lettermint-card lettermint-chart">
			<figcaption class="lettermint-chart-header">
				<p class="lettermint-chart-title">
					<span class="cp-icon small" aria-hidden="true">{{ iconSvg('chart-simple') }}</span>
					{{ 'Emails sent per day'|t('lettermint') }}
				</p>
				<span class="lettermint-section-meta">{{ 'Peak of {count}'|t('lettermint', {count: peak|number}) }}</span>
			</figcaption>
			<div class="lettermint-chart-bars" aria-hidden="true">
				{% for day in daily %}
					{% set value = day.sent %}
					<span
						class="lettermint-chart-bar{{ value == 0 ? ' lettermint-chart-bar-empty' }}"
						style="--lettermint-bar: {{ value / peak * 100 }}%"
						title="{{ day.date|date('medium') }}: {{ value|number }}"
					></span>
				{% endfor %}
			</div>
			<div class="lettermint-chart-axis" aria-hidden="true">
				<span>{{ (daily|first).date|date('medium') }}</span>
				<span>{{ (daily|last).date|date('medium') }}</span>
			</div>
		</figure>
	{% endif %}
{% endmacro %}

{% macro checks(checks) %}
	{% set labels = {
		ok: 'OK'|t('lettermint'),
		warning: 'Warning'|t('lettermint'),
		error: 'Error'|t('lettermint'),
	} %}
	<ul class="lettermint-checks" aria-label="{{ 'Checks'|t('lettermint') }}">
		{% for check in checks %}
			<li class="lettermint-{{ check.status.value }}">
				<span class="cp-icon small" aria-hidden="true">{{ _self.statusIcon(check.status.value) }}</span>
				<span>
					<span class="visually-hidden">{{ labels[check.status.value] }}:</span>
					{{ check.text }}
				</span>
			</li>
		{% endfor %}
	</ul>
{% endmacro %}

{# Links to the email settings. #}
{% macro settingsCallout(status, text) %}
	{{ _self.callout(status, text, tag('a', {
		href: cpUrl('settings/email'),
		class: 'go',
		text: 'Email Settings'|t('lettermint'),
	})) }}
{% endmacro %}

{# The project doesn't belong to the team. #}
{% macro projectMissingCallout(projectId) %}
	{{ _self.settingsCallout('error', 'The project “{id}” is not a project of the team.'|t('lettermint', {id: projectId})) }}
{% endmacro %}

{% macro loadedNote(text) %}
	<p class="lettermint-footer-note">
		<span class="cp-icon small" aria-hidden="true">{{ iconSvg('clock') }}</span>
		<span>{{ text }}</span>
	</p>
{% endmacro %}

{% macro setupCallout(setup) %}
	{% set steps = enum('SomehowDigital\\Craft\\Lettermint\\enums\\Setup') %}
	{% if setup is same as(steps.Transport) %}
		{{ _self.settingsCallout('info', 'Lettermint is not the transport type of the email settings.'|t('lettermint')) }}
	{% elseif setup is same as(steps.Token) %}
		{{ _self.settingsCallout('info', 'Set a team API token in the email settings to see the team of Lettermint here.'|t('lettermint')) }}
	{% elseif setup is same as(steps.Invalid) %}
		{{ _self.settingsCallout('error', 'Lettermint rejects the team API token.'|t('lettermint')) }}
	{% endif %}
{% endmacro %}

{# An icon button as any tag, with an optional screen reader hint. #}
{% macro iconButton(tagName, icon, label, attributes = {}, hint = null) %}
	{{- tag(tagName, attributes|merge({
		class: ['btn', 'lettermint-btn']|merge(attributes.class ?? []),
		html: tag('span', {class: ['cp-icon', 'small'], 'aria-hidden': 'true', html: iconSvg(icon)})
			~ tag('span', {class: 'label', text: label})
			~ (hint ? tag('span', {class: 'visually-hidden', text: hint})),
	})) -}}
{% endmacro %}

{# A part the script replaces once loaded. Placeholders render as a skeleton, replaced by the error on failure. #}
{% macro part(name, class, body, loading, placeholder, announce = true) %}
	<div{{ attr({
		class: [class, placeholder ? 'lettermint-skeleton'],
		'data-lettermint-part': name,
		'data-lettermint-placeholder': placeholder,
		'aria-busy': loading ? 'true' : null,
	}) }}>
		{%- if placeholder -%}
			{% if announce %}
				<p class="visually-hidden" role="status">{{ 'Loading from Lettermint…'|t('lettermint') }}</p>
				<template data-lettermint-error>{{ _self.callout('error', 'This could not be loaded from Lettermint.'|t('lettermint')) }}</template>
			{% endif %}
			<div class="lettermint-skeleton-body" inert>{{ body }}</div>
		{%- else -%}
			{{ body }}
		{%- endif -%}
	</div>
{% endmacro %}
