{# Keeps the button at the end of the toolbar, which spreads its items apart. #}
<div></div>
{{ tag('a', {
	href: dashboardUrl,
	class: ['btn', 'lettermint-btn'],
	target: '_blank',
	rel: 'noopener',
	html: tag('span', { class: ['cp-icon', 'small'], 'aria-hidden': 'true', html: iconSvg('arrow-up-right-from-square') })
		~ tag('span', { class: 'label', text: "Lettermint Dashboard"|t('lettermint') })
		~ tag('span', { class: 'visually-hidden', text: "(opens in a new window)"|t('lettermint') }),
}) }}
