{# The domains of the project, with their verification status. #}
{% import 'lettermint/utility/_macros' as ui %}

{% set domains = data.domains %}
<section aria-labelledby="lettermint-domains">
	{{ ui.sectionHeader('lettermint-domains', 'Domains'|t('lettermint'), domains ? '{count, plural, =1{# domain} other{# domains}}'|t('lettermint', {count: domains|length})) }}

	{% if domains %}
		{% set class = 'SomehowDigital\\Craft\\Lettermint\\data\\Domain' %}
		{% set statuses = {
			(constant(class ~ '::STATUS_VERIFIED')): {color: 'green', label: 'Verified'|t('lettermint')},
			(constant(class ~ '::STATUS_PARTIALLY_VERIFIED')): {color: 'orange', label: 'Partially verified'|t('lettermint')},
			(constant(class ~ '::STATUS_PENDING_VERIFICATION')): {color: 'yellow', label: 'Pending verification'|t('lettermint')},
			(constant(class ~ '::STATUS_FAILED_VERIFICATION')): {color: 'red', label: 'Failed verification'|t('lettermint')},
		} %}
		<div class="lettermint-card">
			<div class="lettermint-table">
				<table class="data fullwidth">
					<thead>
						<tr>
							<th scope="col">{{ 'Domain'|t('lettermint') }}</th>
							<th scope="col">{{ 'Status'|t('lettermint') }}</th>
							<th scope="col">{{ 'Status changed'|t('lettermint') }}</th>
						</tr>
					</thead>
					<tbody>
						{% for domain in domains %}
							{% set status = statuses[domain.status ?? ''] ?? {color: 'gray', label: (domain.status ?? '–')|replace({_: ' '})|capitalize} %}
							<tr>
								<th scope="row">{{ domain.domain ?? '–' }}</th>
								<td>{{ ui.pill(status.color, status.label) }}</td>
								<td>{{ domain.statusChangedAt ? domain.statusChangedAt|date('short') : '–' }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
	{% else %}
		<p class="light">{{ 'The project has no domains yet.'|t('lettermint') }}</p>
	{% endif %}
</section>
