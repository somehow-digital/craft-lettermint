{# The project of the token, with the checks of the settings against it. #}
{% import 'lettermint/utility/_macros' as ui %}

<section aria-labelledby="lettermint-project">
	{{ ui.sectionHeader('lettermint-project', 'Project'|t('lettermint'), project.data and project.auto ? 'The only project of the team'|t('lettermint')) }}

	{% if project.error == 'missing' %}
		{{ ui.callout('error', 'The project “{id}” is not a project of the team.'|t('lettermint', {id: project.id}), settingsLink) }}
	{% elseif project.error %}
		{{ ui.sectionError(project.error) }}
	{% elseif not project.data %}
		{{ ui.callout('info', 'Set the project of the project API token in the email settings to see it and check the settings against it.'|t('lettermint'), settingsLink) }}
	{% else %}
		{% set data = project.data %}
		{% set stats = data.last_28_days ?? {} %}
		{% set emails = (stats.messages_transactional ?? 0) + (stats.messages_broadcast ?? 0) %}
		{% set defaultRoute = (data.routes ?? [])|filter(route => (route.is_default ?? false))|first %}
		<div class="lettermint-card">
			<div class="lettermint-project-header">
				<h3>{{ data.name }}</h3>
				{{ ui.deliveryMode(data) }}
			</div>
			<div class="lettermint-project-body">
				<dl class="lettermint-meta">
					<dt>{{ 'Project ID'|t('lettermint') }}</dt>
					<dd><code>{{ data.id }}</code></dd>
					{% if defaultRoute %}
						<dt>{{ 'Default route'|t('lettermint') }}</dt>
						<dd><code>{{ defaultRoute.slug }}</code></dd>
					{% endif %}
					<dt>{{ 'Emails (28 days)'|t('lettermint') }}</dt>
					<dd>{{ emails|number }}</dd>
					<dt>{{ 'Deliverability'|t('lettermint') }}</dt>
					<dd>{{ ui.deliverability(stats.deliverability ?? null, emails) }}</dd>
					{% if data.token_last_used_at ?? null %}
						<dt>{{ 'Token last used'|t('lettermint') }}</dt>
						<dd>
							{{ data.token_last_used_at|datetime('short') }}
							{% if data.token_last_used_ip ?? null %}
								<span class="light">({{ data.token_last_used_ip }})</span>
							{% endif %}
						</dd>
					{% endif %}
				</dl>

				{% if project.checks %}
					{% set labels = {
						ok: 'OK'|t('lettermint'),
						warning: 'Warning'|t('lettermint'),
						error: 'Error'|t('lettermint'),
					} %}
					<ul class="lettermint-checks" aria-label="{{ 'Checks'|t('lettermint') }}">
						{% for check in project.checks %}
							<li class="lettermint-{{ check.status }}">
								<span class="cp-icon small" aria-hidden="true">{{ ui.statusIcon(check.status) }}</span>
								<span>
									<span class="visually-hidden">{{ labels[check.status] }}:</span>
									{{ check.text }}
								</span>
							</li>
						{% endfor %}
					</ul>
				{% endif %}
			</div>
		</div>
	{% endif %}
</section>
